# Copy to .env and fill in. Every setting in src/rag/core/config.py can be
# overridden here using its UPPER_CASE name.

# --- Required ---
OPENAI_API_KEY=sk-...
# Chat model for generation and judging (never hardcoded in code)
LLM_MODEL=

# --- Optional: use Anthropic instead of OpenAI for generation/judge ---
# LLM_PROVIDER=openai               # openai | anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults shown) ---
# EMBEDDING_MODEL=text-embedding-3-small
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# CORPUS_PATH=corpus/fastapi_docs
# CHROMA_PATH=data/chroma
# DOCUMENTS_PATH=data/documents
# CACHE_PATH=data/cache
# CHUNK_STRATEGY=recursive          # fixed | recursive | semantic
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# DEDUP_THRESHOLD=0.95
# DENSE_K=10
# SPARSE_K=10
# RRF_K=60
# RRF_DENSE_WEIGHT=0.7
# RRF_SPARSE_WEIGHT=0.3
# RERANK_CANDIDATES=20
# RERANK_TOP_N=5
# ABSTAIN_THRESHOLD=0.2
# CONFIDENCE_WEIGHTS={"retrieval": 0.4, "citation_coverage": 0.4, "completeness": 0.2}
